# ==============================================================================
# FinTrust Environment Configuration — EXAMPLE FILE
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Application Environment
APP_NAME=FinTrust
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_PORT=8000

# Database Configuration (PostgreSQL 14+ default, with SQLite automatic fallback)
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fintrust
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here
DB_SQLITE_PATH=database/fintrust.db

# Microservice Endpoints
PHP_SERVICE_PORT=8000
PHP_SERVICE_URL=http://localhost:8000
JAVA_SERVICE_PORT=8080
JAVA_SERVICE_URL=http://localhost:8080

# JWT Authentication (HMAC SHA-256 Shared Secret)
JWT_SECRET=your_jwt_secret_key_here
JWT_ISSUER=fintrust-auth-service
JWT_AUDIENCE=fintrust-microservices
JWT_EXPIRATION_SECONDS=86400

# S3-Compatible Storage Architecture (Simulated & AWS S3 / MinIO Ready)
S3_ENABLED=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fintrust-vault
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
S3_LOCAL_STORAGE_DIR=php-service/uploads/docs
